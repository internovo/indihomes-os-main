# =============================
# IndiHomes local development
# =============================

# Frontend -> backend URL. Vite reads VITE_* values when it starts/builds.
VITE_API_URL=http://localhost:3001

# Optional: Google Maps JavaScript + Places API (New).
# Needed for map rendering and nationwide landmark/business suggestions.
VITE_GOOGLE_MAPS_KEY=

# Optional: server-side Google Places API key for Project Intelligence's
# Competitor Analysis (real nearby-search for competing residential
# projects). A separate var from VITE_GOOGLE_MAPS_KEY above on purpose: that
# one is sent to the browser and should be HTTP-referrer restricted; this one
# is called only from the server and should NOT be referrer restricted.
# Falls back to VITE_GOOGLE_MAPS_KEY if unset (only fine when that key has no
# referrer restriction). Without either, Competitor Analysis shows an honest
# "not connected" state.
GOOGLE_PLACES_API_KEY=

# Express API
PORT=3001
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5174,http://localhost:5173,http://127.0.0.1:5175,http://127.0.0.1:5174

# Local development should normally serve the bundled seed snapshot.
# Set to false only when you want local browser scrapers to refresh data.
DISABLE_AUTO_SCRAPE=true
PYTHON_BIN=python

# SQLite path. Leave blank to use ./data.sqlite.
DB_PATH=

# =============================
# AI Search / Project Selection
# =============================
# Use one provider. Anthropic is preferred; Groq or Gemini can be fallback options.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =============================
# IndiHomes official Projects API — Filter Search's ONLY data source.
# Read endpoints need no auth. Defaults already point at the real API, so
# these can be left blank; set them only to override.
# =============================
INDIHOMES_API_BASE_URL=https://api.indihomes.co.in/api/v1
INDIHOMES_PROJECTS_ENABLED=true
INDIHOMES_PROJECTS_CACHE_TTL_MS=300000
INDIHOMES_PROJECTS_TIMEOUT_MS=10000

# =============================
# AI Search — external (non-IndiHomes) properties only. Azure AI Search is
# the retrieval layer; Claude is never used for search. Everything below
# stays off/no-op until you set EXTERNAL_SEARCH_ENABLED=true AND configure at
# least one connector (Google Custom Search, Bing, or an Apify actor).
# =============================
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_EXTERNAL_INDEX=external-projects
EXTERNAL_SEARCH_ENABLED=false
EXTERNAL_SCRAPING_ENABLED=false
BING_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
# Apify actor connector — requires BOTH a token and an actor id, plus
# EXTERNAL_SCRAPING_ENABLED=true. Point it at an actor you've verified is
# ToS-compliant for whatever site it targets; none is bundled by default.
APIFY_EXTERNAL_ACTOR_ID=
# Direct 99acres/MagicBricks connector (legacy-portal-connector.cjs) — a real,
# non-headless (off-screen positioned) Playwright browse of each portal's
# public new-projects pages, India only, capped to Mumbai/Thane/Pune/Navi
# Mumbai. Requires Playwright's Chromium to be installed locally. Off by
# default; needs a residential IP in production (datacenter IPs get WAF-
# blocked — same limitation already documented for the old Filter Search
# scraper in STATUS.md).
LEGACY_PORTAL_SCRAPING_ENABLED=false

# =============================
# Optional integrations
# =============================
APIFY_TOKEN=
APIFY_MAX_RESULTS=15
SUREPASS_API_TOKEN=
SUREPASS_BASE_URL=https://sandbox.surepass.app

# Housing.com builder leads
HOUSING_API_URL=https://pahal.housing.com/api/v0/get-builder-leads
HOUSING_API_KEY=
HOUSING_USER_ID=

# Meta Lead Ads — needs a Meta App with the "Lead Ads" product added, a
# long-lived PAGE Access Token (not a user token — a user token is what
# produces Graph API's "(#10) User has insufficient privileges on the page"
# error) for the Page the lead forms live on, with these scopes:
# leads_retrieval, pages_show_list, pages_read_engagement, ads_management.
# Also needs, for the webhook (optional — hourly poll works without it), a
# Webhooks subscription to that Page's `leadgen` field using the same verify
# token you set below.
META_PAGE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Meta Conversions API — reports real lead outcomes (whether the CRM push
# succeeded/failed) back to Meta so ad delivery can react to them. Needs a
# Dataset (Events Manager -> Data Sources -> a Conversions API-only dataset)
# and a System User access token with that dataset's ads_management
# permission. META_CAPI_TEST_EVENT_CODE is optional — set it while testing
# in Events Manager's Test Events tab, remove it before going live.
META_CAPI_ACCESS_TOKEN=
META_DATASET_ID=
META_CAPI_TEST_EVENT_CODE=

# =============================
# Official IndiHomes CRM lead push (POST /api/v1/createLead). Disabled by
# default — leads stay local-only until you opt in. When enabled, every new
# (first-touch) lead from manual entry, the website, Meta, and Housing.com is
# pushed after local intake; a failed push keeps the lead locally, marked
# crm_status='failed', and is retried automatically next time that lead is
# touched by any source. This is the ONLY path that reaches IndiHomes' own
# system of record — nothing in this app writes to Cosmos or any other
# external database directly.
# =============================
INDIHOMES_LEAD_PUSH_ENABLED=false
INDIHOMES_LEAD_PUSH_TIMEOUT_MS=10000

# Used by the local refresh/publish scripts when the API is not on port 3001.
LOCAL_API=http://localhost:3001

# =============================
# AI Search Agent (LangGraph) — see requirements.md's "AI Search Agent"
# section for the full explanation of every variable below. Fully optional:
# with LANGGRAPH_ENABLED unset, /api/ai-search behaves exactly as before
# this pipeline existed. NO Anthropic/Claude dependency anywhere in it.
# =============================
LANGGRAPH_ENABLED=false
AGENT_SERVICE_URL=http://localhost:8008
AGENT_PORT=8008
# Shared secret between Node and the Python agent service's internal tool
# bridge — set a real random value before running this anywhere but
# localhost. Has a fixed local-dev default if left blank.
AGENT_INTERNAL_TOKEN=
# This is server.cjs's HTTP timeout for the WHOLE POST /agent/ai-search
# call — not any single tool's own timeout. The deep-research pipeline
# (fetch_page + fact extraction + a field-aware research-gap loop, on top
# of the original discovery search) is genuinely slower than the original
# single-pass search: verified live in this build at ~25-110s for a real
# query depending on how many candidates/pages/loop iterations it actually
# needed. 45000 (the old default, sized for single-pass search only) WILL
# time out real deep-research requests — confirmed live, this is not a
# hypothetical. Bump this before enabling LANGGRAPH_ENABLED in anything
# resembling production; lower AI_SEARCH_MAX_RESEARCH_ITERATIONS/
# AI_SEARCH_MAX_CANDIDATES_FOR_DEEP_RESEARCH below instead if you'd rather
# trade research depth for latency than raise this further.
AI_SEARCH_TIMEOUT_MS=120000

# Bridge reliability (Part 3.2 of the handoff/reliability pass) — a SINGLE
# Node-bridge HTTP call's own timeout/retry behavior, deliberately separate
# from AI_SEARCH_TIMEOUT_MS above (that one bounds the WHOLE request, this
# bounds one tool call to agent-tools-bridge.cjs). A short connect timeout
# means a genuinely-down bridge is discovered in ~3s, not the full request
# budget; MAX_RETRIES/BACKOFF only apply to connection failures (bridge
# unreachable), never to a real HTTP error response the bridge already
# answered. Once retries are exhausted the bridge is marked unavailable for
# AGENT_BRIDGE_UNAVAILABLE_TTL_MS so every other tool call in the same (and
# near-future) request fails fast instead of repeating the same doomed
# retry sequence — see agent/agent/tools.py's check_bridge_available()/
# _call_bridge().
AGENT_BRIDGE_TIMEOUT_MS=15000
AGENT_BRIDGE_CONNECT_TIMEOUT_MS=3000
AGENT_BRIDGE_MAX_RETRIES=2
AGENT_BRIDGE_BACKOFF_BASE_MS=400
AGENT_BRIDGE_UNAVAILABLE_TTL_MS=30000

AI_SEARCH_CACHE_TTL_MS=600000
AI_SEARCH_SOURCE_CACHE_TTL_MS=21600000
AI_SEARCH_INTEL_CACHE_TTL_MS=86400000
AI_SEARCH_MAX_RESEARCH_ITERATIONS=2

# Deep-research budget knobs (Part 45 of the agentic-research-pipeline
# upgrade) — every one bounds the fetch_page/targeted-search loop so one
# user query can never trigger runaway cost/latency. Recorded verbatim into
# every response's research_metadata.limits.
AI_SEARCH_MAX_CANDIDATES_FOR_DEEP_RESEARCH=3
AI_SEARCH_MAX_FETCHES_PER_CANDIDATE=3
AI_SEARCH_MAX_TARGETED_SEARCHES_PER_ITERATION=5
AI_SEARCH_TARGETED_RESEARCH_TOP_N=3
AI_SEARCH_MIN_STRONG_RESULTS=2

# fetch_page (Part 4) — the Node bridge route (agent-tools-bridge.cjs) that
# actually retrieves+extracts a discovered URL's content for the agent.
# Escalates to a real Playwright render (legacy-portal-connector.cjs) only
# when a plain HTTP fetch comes back too thin AND
# LEGACY_PORTAL_SCRAPING_ENABLED=true below — no new dependency either way.
AGENT_FETCH_PAGE_TIMEOUT_MS=12000
AGENT_FETCH_PAGE_MAX_CHARS=6000

# Tavily — AI-native web search (primary research tool, strongly
# recommended). Distinct from Google/Bing below: it runs its own retrieval +
# relevance ranking and returns already-extracted page content rather than a
# bare snippet, which is what makes it noticeably better at surfacing
# builder/developer pages and project-specific detail pages. Complements,
# never replaces, Google/Bing/Apify/portal connectors — the planner tries
# all configured tools in parallel. Its own AI-generated `answer` field is
# never requested/used (include_answer=false) — only the raw search results
# feed this app's own fact-extraction/verification pipeline.
TAVILY_API_KEY=
TAVILY_SEARCH_ENABLED=false
# 1-20. Higher = more evidence per query, more API usage.
TAVILY_MAX_RESULTS=10
# 'basic' (fast/cheap) or 'advanced' (deeper, higher-relevance) — sets the
# depth for the agent's first-pass discovery search. Targeted per-candidate
# research (once promising projects are named) always uses 'advanced'
# regardless of this setting.
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_MS=15000

# LLM providers for the agent's optional planning/curation steps — Grok
# and/or Gemini, both via their OpenAI-compatible endpoints. Neither is
# required; the agent produces a complete, real-evidence-backed result with
# zero LLM keys set (deterministic summary instead of an LLM-written one).
XAI_API_KEY=
XAI_MODEL=grok-4-fast
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Which provider (xai|gemini|openai|local) handles each role — each role
# still has a full fallback chain regardless of these settings.
MODEL_REASONING=xai
MODEL_EXTRACTION=gemini
MODEL_FALLBACK=gemini

# A version tag stamped onto every AI Search response's
# research_metadata.agent_version and every LangSmith trace's metadata —
# lets you tell which pipeline version produced a given trace/result once
# this evolves further. Not a real semver contract, just a label.
AGENT_VERSION=2.0.0

# =============================
# LangSmith — observability for the AI Search agent's LangGraph pipeline
# (Part 23 of the agentic-research-pipeline upgrade). Entirely optional:
# with LANGSMITH_TRACING unset/false, the agent runs identically, with zero
# network calls to LangSmith and zero behavior change — this is a pure
# observability add-on, never a functional dependency.
#
# NEVER put your real key in this file (.env.example is committed) — only
# in your own untracked .env. See agent/README.md's "LangSmith setup" for
# the exact steps (where to create the key, what project name to use, how
# to verify a trace appears).
# =============================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Which LangSmith project receives these traces — create it (or let
# LangSmith auto-create it on first trace) with this exact name.
LANGSMITH_PROJECT=indihomes-ai-search
# Only needed if your LangSmith account belongs to more than one
# workspace and the key above isn't already workspace-scoped — see
# agent/README.md.
LANGSMITH_WORKSPACE_ID=
# Only needed for a non-US LangSmith data region (e.g. the EU region) —
# leave blank for the default (api.smith.langchain.com).
LANGSMITH_ENDPOINT=

# Lead events pipeline (see backend/LEAD_EVENTS_INTEGRATION.md) — chatbot-V1
# and Phase 2 push WhatsApp/voice checkpoint events to POST /api/lead-events
# on THIS service; no shared secret is needed on this side for that inbound
# path (the two bot repos hold their own OS_EVENTS_SHARED_SECRET - see their
# own .env.example files). SARVAM_WEBHOOK_SHARED_SECRET below is an OPTIONAL
# signature check on the Sarvam webhook adapter - Sarvam's actual signing
# behavior was not verified against a live account while building this (see
# lead-events.cjs, "Trap 6"); leave unset to skip the check.
SARVAM_WEBHOOK_SHARED_SECRET=
